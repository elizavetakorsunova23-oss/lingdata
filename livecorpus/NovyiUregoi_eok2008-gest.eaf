    <TIER ANNOTATOR="elizavetakorshunova23-oss"
        LINGUISTIC_TYPE_REF="gesture_comment"
        PARENT_REF="gestType@eok2008f" PARTICIPANT="@eok2008f" TIER_ID="gestComment@eok2008f">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a288" ANNOTATION_REF="a285">
                <ANNOTATION_VALUE>попытка помочь себе подобрать слова</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a289" ANNOTATION_REF="a253">
                <ANNOTATION_VALUE>разграничение: Тюменская - Кемеровская область</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a291" ANNOTATION_REF="a242">
                <ANNOTATION_VALUE>наложение жестов пальцами и головой в сторону (начинается с недели две)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a297" ANNOTATION_REF="a290">
                <ANNOTATION_VALUE>Поворот пальцем не совсем понятен, противопоставление?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a307" ANNOTATION_REF="a261">
                <ANNOTATION_VALUE>наложение "теребить пальцами" и "мотнуть головой влево"</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a312" ANNOTATION_REF="a308">
                <ANNOTATION_VALUE>можно было бы к изобразительным, но здесь скорее мотание "покругу", а не вверх вниз, как обычно бывает при согласии</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a318" ANNOTATION_REF="a309">
                <ANNOTATION_VALUE>легкое мотание головой как поиск слова или заполнение паузы?(я посчитала что поиск слова это что-то более конктреное - как щелкать пальцами в воздухе)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a322" ANNOTATION_REF="a256">
                <ANNOTATION_VALUE>Я разделила прикосновения к лицу (я как бы закрываю его рукой) и потирание виска - первое совпадает с начальным "подбиранием"слов - цель спрятаться от взгляда и подумать, а второе совпадает с уже развернутой речью)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a346" ANNOTATION_REF="a258">
                <ANNOTATION_VALUE/>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a270" ANNOTATION_REF="a262">
                <ANNOTATION_VALUE>есть сомнения по поводу этого наклонения головы вперед, как бы подхватывание фразы за собеседником</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a328" ANNOTATION_REF="a323">
                <ANNOTATION_VALUE>Среди перечисленных в МУРКО значений я не увидела отрицания, недоумение не подходит</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a331" ANNOTATION_REF="a266">
                <ANNOTATION_VALUE>добавление к существующему, раннее названому ряду еще одного элемента (зимой)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a338" ANNOTATION_REF="a332">
                <ANNOTATION_VALUE>интерес(к реакции собеседника в первую очередь)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a342" ANNOTATION_REF="a339">
                <ANNOTATION_VALUE>нигде нет глубокого вздоха как жеста, но пожимание плечами есть, здесь я думала между адаптором как радостным состоянием и прагматическим жестом как "что говорить дальше", способ заполнить паузу)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
